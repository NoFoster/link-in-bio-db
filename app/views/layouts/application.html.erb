<!DOCTYPE html>
<html>
  <head>
    <!--Syne Font-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400..800&display=swap" rel="stylesheet">
<!--- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Syne:wght@400..800&display=swap" rel="stylesheet">

    <!---  Font Awesome-->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/js/all.min.js"></script>


    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">


<style>
    /*
    * {
     border: 1px red dashed; 
    }
*/
    html {
      min-height: 100%;
    }

  body {
    min-height: 100%;
    padding-top: 40px;
    padding-bottom: 40px;
    background: linear-gradient(180deg, #5b5b5b, #746455, #8b6d4f, #a37648, #ba7e40, #d18736, #e89029, #ff9913);
        color: rgba(0, 0, 0, 1.0);
        font-family:"Inter";
  }

    .avatar-image {
      width: 128px;
      height:128px;
      object-fit: cover;
      border-radius: 128px;
    }

      .thumbnail {
            width: 48px;
            height: 48px;
            border-radius: 48px;
            object-fit: cover;
      }
    
    a {
      color: rgba(255, 255, 255, 1.0)
      text-decoration: none;
    }
      .item{
        background-color: rgba(238, 238, 238, 0.8);
        border-radius: 1000px;
        padding: 5px;
        padding-right: 53px;
        box-shadow: 4px 4px 10px 0px rgba(156, 156, 156, 0.5);
      }
     
      .main-container {
        max-width: 640px;
        margin:auto;
      }

      .image-row {
        margin-bottom: 20px;
        text-align: center;
      }

      .name-row {
        margin-bottom: 30px;
        text-align: center;
        font-family: "Syne";
        font-size: 24px;
        font-weight: 600;
      }

      .social-icons-row {
        margin-bottom: 30px;
        display: flex;
        justify-content: space-around;
        font-size: 30px;
        color: rgba(255, 255, 255, 1.0)
    
      }

      .item {        
        margin-bottom: 20px;
        display: flex;
        align-items: center;
      }

      .link-text {
        text-align: center;
        flex-grow: 1;
        color: black;
      }

  </style>

  
    <title>Link-in-bio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
